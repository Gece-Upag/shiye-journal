<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        规格 1.1 / 9.3：不统计、不埋点，也不请求不必要的权限。

        INTERNET 是 V2 引入可选 AI 之后才加的（规格 §2.1 / §8），
        且**只有 INTERNET 这一个**：不申请存储权限（文件读写走 SAF）、
        不申请网络状态权限（不做连通性预检）。

        拿到这个权限不等于会联网 —— AI 默认关闭，关闭时一个字节都不会往外发；
        只有用户在日记里主动点「AI 润色 / 总结」，才会按他填的地址发一次请求
        （规格 §8.2）。整个 App 唯一发起网络请求的地方是
        com.shiye.journal.features.ai.OkHttpEngine。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ShiyeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shiye">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Shiye"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
